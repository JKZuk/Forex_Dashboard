# --- Database (existing local MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=fx_dashboard
# Optional: full SQLAlchemy URL, overrides the DB_* values above
# (e.g. sqlite:///./dev.db for a throwaway test database)
# DATABASE_URL=

# --- Free API keys (all optional; sources degrade gracefully without them) ---
# Free key from https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# --- Scheduler ---
# Minutes between automatic refreshes while the server runs (0 = manual only)
REFRESH_INTERVAL_MINUTES=0

# --- News sentiment engine: lexicon (default, no downloads) or finbert ---
SENTIMENT_ENGINE=lexicon
